# All variables are OPTIONAL — the suite runs with zero configuration.
# Defaults target the public demo API with its publicly documented demo
# credentials (https://restful-booker.herokuapp.com/apidoc); none of these
# values are secrets.

# Point the suite at another instance (e.g. a locally hosted restful-booker):
# BASE_URL=http://localhost:3001

# BOOKER_USERNAME=admin
# BOOKER_PASSWORD=password123

# Make faker data deterministic; every test annotates the seed it ran with.
# FAKER_SEED=12345
